{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deploying: `npm run build` makes @astrojs/cloudflare emit a fully
  // resolved dist/server/wrangler.json from THIS file (it injects
  // main: entry.mjs + assets: ../client — do not add main/assets here).
  // Deploy with `npm run deploy`, or in Cloudflare Workers Builds set:
  //   root dir `site` · build `npm run build`
  //   deploy `npx wrangler deploy --config dist/server/wrangler.json`
  // Must stay byte-identical to the Worker that Workers Builds is connected to
  // (`texashomeintelligence`, no hyphens, repo zmpersonal/texashomeintelligence).
  // It was previously the hyphenated `texas-home-intelligence`, which Cloudflare
  // flagged as a mismatch; a `wrangler deploy` under that name would have
  // created a SECOND Worker on its own workers.dev hostname rather than
  // updating staging. Do not "tidy" this into the hyphenated form to match the
  // D1/KV resource names below — those are separate resources and are correctly
  // hyphenated. Renaming the Worker is an owner action in the dashboard first,
  // this field second.
  "name": "texashomeintelligence",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],

  // Seam 3 (HANDOFF.md). These IDs were long commented as "LOCAL PLACEHOLDERS
  // ONLY"; they are not. All three were verified against the owner's real
  // Cloudflare account — the two KV namespace IDs match the live namespaces
  // (texas-home-intelligence-projects and texashomeintelligence-session), and
  // the D1 id matches the live texas-home-intelligence-db. Nothing needs
  // swapping before a deploy.
  "kv_namespaces": [
    // Intake project state and resumable return tokens (src/lib/kv.ts writes
    // `project:` and `token:` keys here).
    { "binding": "PROJECTS_KV", "id": "d5c64f949583450db1bd1cee073caf23" },
    // Astro Sessions. No application code touches this binding; the
    // @astrojs/cloudflare adapter claims it by name at build time ("Enabling
    // sessions with Cloudflare KV with the SESSION KV binding"), so the name
    // must stay exactly `SESSION`.
    {
      "binding": "SESSION",
      "id": "cc7a5a1c29e04852ace9723ed69969bb"
    }
  ],
  // Durable store for intake projects, answers, generated briefs and
  // contractor requests (src/lib/db.ts).
  // migrations/0001_init.sql was applied to the REMOTE database on 2026-08-29
  // at the owner's instruction. Verified present: tables projects,
  // intake_responses, generated_briefs, contractor_requests, plus the indexes
  // idx_intake_responses_project and idx_contractor_requests_project.
  // migrations/seed.sql has NOT been applied and must not be — it inserts
  // sample rows, which have no place in a production store.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "texas-home-intelligence-db",
      "database_id": "0b1f11b2-b8f4-4eeb-b36e-4debd9f5c956"
    }
  ]
}
