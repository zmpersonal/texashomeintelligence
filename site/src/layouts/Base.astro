---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  /** PPC landing pages set this true — noindex to avoid duplicate-content
   * collision with the equivalent SEO page, per CLAUDE.md's two-page-family
   * rule. Defaults to indexable. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const siteName = "Texas Home Intelligence";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      name: siteName,
      url: Astro.site?.toString(),
      description:
        "Free QuoteReady Project Brief tool and local homeowner intelligence for Texas homeowners.",
      areaServed: { "@type": "State", name: "Texas" },
    })}
    />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
