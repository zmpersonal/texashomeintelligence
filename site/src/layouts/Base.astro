---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { absolute, organizationId, websiteId } from "../lib/urls";

interface Props {
  title: string;
  description: string;
  /** PPC landing pages set this true — noindex to avoid duplicate-content
   * collision with the equivalent SEO page, per CLAUDE.md's two-page-family
   * rule. Defaults to indexable. */
  noindex?: boolean;
  /** Editorial pages opt into Article schema. Data pages don't — they emit
   * Dataset instead, which is the more specific and more citable type. */
  article?: {
    /** ISO 8601. Omit rather than guess: a wrong dateModified is worse than
     * none, since it is exactly the freshness signal crawlers lean on. */
    dateModified?: string;
    datePublished?: string;
    section?: string;
  };
}

const { title, description, noindex = false, article } = Astro.props;
const siteName = "Texas Home Intelligence";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const orgId = organizationId(Astro.site);
const siteId = websiteId(Astro.site);

// Social card: a 1200x630 JPEG (the ratio both Open Graph and
// `summary_large_image` want), the mark centred on Depth Navy. Committed as a
// static asset rather than derived at build time — running the 1.6 MB source
// through the compile-time image service emitted two multi-megabyte PNGs, one
// of them larger than the original, for every deploy.
// TODO(round: share cards): replace with a purpose-built card from the
// share-card system (brand kit §10), which can carry a live reading.
const OG_IMAGE = { path: "/images/og-card.jpg", width: 1200, height: 630 };
const ogImageUrl = absolute(OG_IMAGE.path, Astro.site);

/** The live THI social profiles, for Organization.sameAs. Deliberately does
 * not include texashomeintelligence.com — that is the canonical `url`, and
 * listing it here would assert the site is a separate profile of the entity. */
const SAME_AS = [
  "https://www.facebook.com/profile.php?id=61593991198459",
  "https://www.instagram.com/texashomeintelligence/",
  "https://www.threads.com/@texashomeintelligence",
];

// Analytics — Seam-adjacent (see HANDOFF.md "Analytics"): both IDs are
// real Cloudflare Pages build-time env vars (PUBLIC_* so Vite exposes them
// to the client), left unset here. Nothing analytics-related renders
// until you supply real IDs — we never ship a placeholder/fake ID that
// would silently start sending traffic to a property that doesn't exist.
const ga4Id = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID;
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;

// Referrers from AI answer engines land in GA4's "Direct" bucket by
// default because these tools don't send standard search-style referrer
// tags. We capture the first-touch referrer's host once per session and
// resend it as a `ai_referral_source` param on every hit, so it survives
// internal navigation and a GA4 custom channel-group rule can key off it
// (see HANDOFF.md for the exact GA4-UI steps — that part isn't
// code-configurable). See CLAUDE.md's Analytics section for the domain
// list.
const AI_REFERRAL_DOMAINS = [
  "chatgpt.com",
  "perplexity.ai",
  "claude.ai",
  "gemini.google.com",
  "copilot.microsoft.com",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL} />

    {/* Preload only the two faces that paint above the fold on every page:
        body text and the serif heading. The other four (Plex Sans 600/700,
        Plex Mono 400/700) are discovered from CSS as usual — preloading a face
        a given page might not use would spend bandwidth to save nothing. */}
    <link
      rel="preload"
      href="/fonts/ibm-plex-sans-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/newsreader-500.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={`${siteName} — live, sourced local data for Texas homeowners`} />
    {article?.dateModified && (
      <meta property="article:modified_time" content={article.dateModified} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/*
      The publishing entity, referenced by @id from every other node on the
      site (Dataset creator/publisher, WebSite publisher, Article publisher)
      so citations accrue to one entity rather than to many loose copies.
      This replaced a `WebApplication` node for the QuoteReady Project Brief
      that used to render on all 38 pages — describing a deferred lead-gen
      tool, with each page's own description, as the site's primary entity.
    */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": orgId,
      name: siteName,
      alternateName: "THI",
      url: absolute("/", Astro.site),
      description:
        "Independent home-intelligence platform for Texas homeowners: live local weather, storm, permit, drought and energy data, translated into plain-language guidance with the source and date on every reading.",
      logo: {
        "@type": "ImageObject",
        url: ogImageUrl,
        width: OG_IMAGE.width,
        height: OG_IMAGE.height,
      },
      areaServed: { "@type": "State", name: "Texas" },
      knowsAbout: [
        "Texas home maintenance",
        "hail and storm damage",
        "residential building permits",
        "drought and foundation movement",
        "residential electricity prices",
      ],
      // The live THI profiles. `sameAs` is how search and answer engines
      // confirm these are all the same entity, so citations consolidate onto
      // one Organization instead of scattering. Note this is deliberately
      // *not* the canonical site — that is `url` above; listing the site here
      // as well would assert it is a separate profile of the same entity.
      sameAs: SAME_AS,
    })}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": siteId,
      name: siteName,
      url: absolute("/", Astro.site),
      description:
        "Live, sourced local data and home intelligence for Texas homeowners.",
      inLanguage: "en-US",
      publisher: { "@id": orgId },
    })}
    />
    {article && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        "@id": `${canonicalURL.toString()}#article`,
        headline: title,
        description,
        url: canonicalURL.toString(),
        inLanguage: "en-US",
        isPartOf: { "@id": siteId },
        publisher: { "@id": orgId },
        author: { "@id": orgId },
        image: ogImageUrl,
        ...(article.section ? { articleSection: article.section } : {}),
        ...(article.datePublished ? { datePublished: article.datePublished } : {}),
        ...(article.dateModified ? { dateModified: article.dateModified } : {}),
      })}
      />
    )}

    {ga4Id && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
        <script
          is:inline
          define:vars={{ ga4Id, AI_REFERRAL_DOMAINS }}
        >
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag("js", new Date());

          var STORAGE_KEY = "thi_ai_referral_source";
          var stored = null;
          try { stored = sessionStorage.getItem(STORAGE_KEY); } catch (e) {}

          if (!stored && document.referrer) {
            try {
              var refHost = new URL(document.referrer).hostname.replace(/^www\./, "");
              var matched = AI_REFERRAL_DOMAINS.find(function (d) { return refHost === d || refHost.endsWith("." + d); });
              if (matched) {
                stored = matched;
                try { sessionStorage.setItem(STORAGE_KEY, matched); } catch (e) {}
              }
            } catch (e) {}
          }

          if (stored) {
            gtag("set", "user_properties", { ai_referral_source: stored });
          }
          gtag("config", ga4Id, stored ? { ai_referral_source: stored } : {});
        </script>
      </>
    )}
    {cfBeaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cfBeaconToken}"}`}
      ></script>
    )}
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
