---
/**
 * Location × service page.
 *
 * Round 2 changes:
 *  - The SAMPLE card is gone. It rendered `status="sample"` on all 14 indexed
 *    pages beneath a note promising a live feed "once connected" — while feeds
 *    for these locations had in fact been live for some time. Each page now
 *    shows a real reading from a dataset that genuinely bears on the service
 *    (see lib/serviceSignals.ts), with source and dates, or says plainly that
 *    no measured signal exists for it yet.
 *  - The hero's "Sample output" QuoteReady brief panel is replaced by the live
 *    conditions panel, so the first visual is measured local data.
 *  - `evaluationItems` and `estimateQuestions` — already authored, previously
 *    read only by the private brief generator — are surfaced as the extractable
 *    blocks an answer engine can quote. No new copy was written for them.
 *  - The visible "Draft copy — pending final editorial review" flag no longer
 *    renders; it is an internal editorial state, not something to publish.
 */
import Base from "./Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import DataStatus from "../components/DataStatus.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import LiveConditionsPanel from "../components/LiveConditionsPanel.astro";
import { getEntry } from "astro:content";
import { hasDataHub, publishedDataPages } from "../lib/dataPages";
import { findDataset, freshnessOf } from "../lib/datasets";
import { SERVICE_SIGNALS, SERVICES_WITHOUT_SIGNAL } from "../lib/serviceSignals";
import BelowHero from "../components/BelowHero.astro";
import { belowHeroSpec } from "../data/belowHero";
import { tradeActivity } from "../lib/tradeActivity";
import { SERVICE_NOTICES } from "../data/serviceNotices";

interface Props {
  serviceSlug: string;
  locationSlug: string;
}

const { serviceSlug, locationSlug } = Astro.props;
const hasHub = hasDataHub(locationSlug);

const svcEntry = await getEntry("services", serviceSlug);
const locEntry = await getEntry("locations", locationSlug);
if (!svcEntry || !locEntry) {
  throw new Error(`ServicePage: unknown service "${serviceSlug}" or location "${locationSlug}"`);
}
const svc = svcEntry.data;
const loc = locEntry.data;

const cityName = loc.name;

const otherLocationSlug = locationSlug === "austin" ? "san-antonio" : "austin";
const otherLocationEntry = await getEntry("locations", otherLocationSlug);
const otherLocationName = otherLocationEntry?.data.name ?? "";

// The measured signal for this service in this city, if one genuinely exists.
const localPages = publishedDataPages(locationSlug);
const signal = SERVICE_SIGNALS[serviceSlug];
const signalSpec = signal
  ? (localPages.find((s) => s.topic === signal.topic) ??
     (signal.fallbackTopic ? localPages.find((s) => s.topic === signal.fallbackTopic) : undefined))
  : undefined;

const signalReading = signalSpec
  ? (() => {
      const dataset = findDataset(signalSpec.datasetId, signalSpec.location)!;
      const observations = dataset.observations
        .filter((o) => !o.seed)
        .sort((a, b) => b.observedAt.localeCompare(a.observedAt));
      return {
        dataset,
        freshness: freshnessOf(dataset),
        stats: signalSpec.stats({ dataset, observations }),
        findings: signalSpec.keyFindings({ dataset, observations }),
      };
    })()
  : undefined;

const noSignalReason = SERVICES_WITHOUT_SIGNAL[serviceSlug];

/**
 * Round 10. The below-hero content layer, when this location AND service has
 * one. It REPLACES the QuoteReady-era body: the authored sections, the
 * evaluation/estimate lists, the closing CTA band and the YAML FAQ. Pages
 * without a layer are untouched, which is how Austin renders byte-identically
 * while San Antonio's plumbing and HVAC pages are rebuilt.
 *
 * `services/*.yaml` is per-SERVICE and shared by both metros, so the San
 * Antonio replacement could not be an edit to it — see data/belowHero.ts.
 */
const belowHero = belowHeroSpec(locationSlug, serviceSlug);
const activity = belowHero ? tradeActivity(locationSlug, belowHero.category) : undefined;
if (belowHero && !activity) {
  throw new Error(
    `ServicePage: ${locationSlug}/${serviceSlug} has a below-hero layer but no ` +
      `permit-trade-activity rows for category "${belowHero.category}". The page would ` +
      `render a content layer with no data behind it — refusing to build it.`,
  );
}
const notices = belowHero ? (SERVICE_NOTICES[`${locationSlug}/${serviceSlug}`] ?? []) : [];

// The hero's STRUCTURE is unchanged this round — no new tool, no address
// input; the readings that belong there need parcel data San Antonio does not
// have. Its COPY is replaced wherever a below-hero layer exists, because the
// QuoteReady funnel it advertised is retired and a retired funnel's pitch is
// not a thing to leave on an indexed page.
const heroTagline = belowHero ? belowHero.hero.h1 : svc.heroTagline.replace(/\{CITY\}/g, cityName);
const eyebrow = belowHero ? belowHero.hero.eyebrow : svc.eyebrow.replace(/\{CITY\}/g, cityName);
const heroBody = belowHero ? belowHero.hero.lede : svc.heroBody;
const heroMicrocopy = belowHero ? belowHero.hero.microcopy : svc.heroMicrocopy;

const title = belowHero
  ? `${svc.name} permit activity in ${cityName}, TX — counts, timing and sources | Texas Home Intelligence`
  : `${svc.name} in ${cityName}, TX — Local Data & What to Know | Texas Home Intelligence`;
// `svc.name.toLowerCase()` renders "a hvac project" — correct for every other
// service, wrong for an acronym. The layer carries its own noun.
const description = belowHero
  ? `How many ${belowHero.subjectNoun} permits ${cityName} issues, month by month, from the city's own permit record — with the permit types behind the count, what the data cannot support, and every source named.`
  : `What ${cityName} homeowners should know before a ${svc.name.toLowerCase()} project: the local conditions we track, what a contractor should evaluate, and the questions worth asking first.`;

const dateModified = activity?.freshness.asOf ?? signalReading?.freshness.asOf;
---

<Base
  title={title}
  description={description}
  article={{ dateModified, section: svc.name }}
>
  <Breadcrumbs
    crumbs={[
      { name: "Home", url: "/" },
      { name: cityName, url: `/${locationSlug}/` },
      { name: svc.name, url: `/${locationSlug}/${serviceSlug}/` },
    ]}
  />

  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">{eyebrow}</span>
        <h1>{heroTagline}</h1>
        <p class="lede">{heroBody}</p>
        <div class="hero-actions">
          {belowHero ? (
            <>
              <a class="btn" href="#data">See the permit data</a>
              <a class="btn secondary" href="#sources">Sources and limitations</a>
            </>
          ) : (
            <a class="btn" href={`/start/?service=${serviceSlug}&location=${locationSlug}`}>
              Build a Project Brief
            </a>
          )}
          {hasHub && (
            <a class="btn secondary" href={`/data/${locationSlug}/`}>See {cityName} data</a>
          )}
        </div>
        <p class="microcopy" set:html={heroMicrocopy} />
        {svc.safetyNote && <p class="disclaimer-note">{svc.safetyNote}</p>}
        {svc.licensingNote && <p class="disclaimer-note">{svc.licensingNote}</p>}
        {svc.permitNote && <p class="disclaimer-note">{svc.permitNote}</p>}
      </div>
      <LiveConditionsPanel
        location={locationSlug}
        locationLabel={cityName}
        topics={localPages.map((s) => s.topic)}
      />
    </div>
  </section>

  {!belowHero && signalReading && signalSpec && (
    <section class="block">
      <div class="wrap" style="max-width:820px;">
        <h2>What the local data says about {svc.name.toLowerCase()} in {cityName}</h2>
        <ul class="key-findings">
          {signalReading.findings.slice(0, 4).map((f) => <li>{f}</li>)}
        </ul>
        <p><strong>Why this matters for {svc.name.toLowerCase()}:</strong> {signal.why}</p>
        <div class="card data-card">
          <p class="metric-label">{signalReading.stats[0].label}</p>
          <p class="metric-value">{signalReading.stats[0].value}</p>
          <DataStatus
            status={signalReading.freshness.display}
            asOf={signalReading.freshness.asOf}
            dataThrough={signalReading.freshness.dataThrough}
            source={signalReading.dataset.source.name}
          />
        </div>
        <p style="margin-top:16px;">
          <a href={`/data/${signalSpec.location}/${signalSpec.topic}/`}>
            Full {signalSpec.h1.toLowerCase()} data, sources and limitations &rarr;
          </a>
        </p>
      </div>
    </section>
  )}

  {!belowHero && !signalReading && noSignalReason && (
    <section class="block">
      <div class="wrap" style="max-width:820px;">
        <h2>What local data do you have on {svc.name.toLowerCase()}?</h2>
        <p>{noSignalReason}</p>
        {hasHub && (
          <p>
            The conditions we do track for {cityName} are in the{" "}
            <a href={`/data/${locationSlug}/`}>{cityName} data hub</a>.
          </p>
        )}
      </div>
    </section>
  )}

  {belowHero && activity && (
    <BelowHero
      spec={belowHero}
      activity={activity}
      cityName={cityName}
      location={locationSlug}
      notices={notices}
    />
  )}

  {!belowHero && svc.sections.map((s, i) => (
    <section class={`block ${i % 2 === 1 ? "alt" : ""}`}>
      <div class="wrap" style="max-width: 760px;">
        <h2>{s.heading}</h2>
        <Fragment set:html={s.body} />
      </div>
    </section>
  ))}

  {/* Both lists are existing authored content that previously reached nobody:
      the brief generator read them privately. As visible, extractable blocks
      they are among the most quotable things on the page.
      Round 10: suppressed where a below-hero layer owns the page — both lists
      are framed around getting a QUOTE, which is the retired funnel's job. */}
  {!belowHero && (
  <section class="block alt">
    <div class="wrap" style="max-width:760px;">
      <h2>What should a {svc.name.toLowerCase()} contractor evaluate?</h2>
      <p>
        A thorough {cityName} {svc.name.toLowerCase()} assessment should cover each of these
        before anyone quotes a price:
      </p>
      <ul class="key-findings">
        {svc.evaluationItems.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="block">
    <div class="wrap" style="max-width:760px;">
      <h2>What should I ask before getting a {svc.name.toLowerCase()} quote?</h2>
      <p>
        These are the details that most often change a {svc.name.toLowerCase()} price, and the
        ones worth settling before you compare quotes:
      </p>
      <ul class="key-findings">
        {svc.estimateQuestions.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <h2>{svc.closingHeading}</h2>
      <p style="max-width:40em;margin:0 auto 20px;">{svc.closingBody}</p>
      <a class="btn" href={`/start/?service=${serviceSlug}&location=${locationSlug}`}>
        Build a Project Brief
      </a>
    </div>
  </section>

  <section class="block">
    <div class="wrap" style="max-width: 760px;">
      <FaqAccordion heading={`${svc.name} FAQ`} items={svc.faq} />
    </div>
  </section>
  )}

  <section class="block alt">
    <div class="wrap center">
      <p style="margin:0;">
        Also see {svc.name} in{" "}
        <a href={`/${otherLocationSlug}/${serviceSlug}/`}>{otherLocationName}</a>
        {" "}&bull;{" "}
        <a href={`/${locationSlug}/`}>All {cityName} services</a>
        {/* ROADMAP: Services is permanently removed from nav — "do not re-add
            or link". The link survived here. Removed on the pages this round
            rebuilds; the Austin instances are recorded as a finding rather
            than changed, because Austin is out of scope this round. */}
        {!belowHero && (
          <>
            {" "}&bull;{" "}
            <a href="/services/">All services</a>
          </>
        )}
      </p>
    </div>
  </section>
</Base>
