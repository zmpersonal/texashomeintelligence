---
// THI-round-homepage-nav.md §1/§2 (revised — Services dropped, see repo
// root round spec + agreed deviation). This component renders on every
// page via Base.astro, so the header CTA and restructured nav are
// sitewide, not homepage-only.
const ctaLabel = "My Dashboard";
---

<div class="topbar">
  <div class="wrap">
    <span>Free for homeowners &bull; No phone number required to start</span>
    <span>Austin &amp; San Antonio &bull; more Texas metros coming soon</span>
  </div>
</div>
<header class="site-nav">
  <div class="wrap">
    <a class="brand-mark" href="/">Texas Home<span>Intelligence</span></a>

    <!-- Mobile hamburger toggle — CSS-only (checkbox hack), no JS. The
    nav links below are always real <a href> in the DOM; this only ever
    toggles their CSS display, so they're crawlable and reachable via
    keyboard/screen reader regardless of viewport or JS. -->
    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Menu">&#9776;</label>

    <nav aria-label="Primary" class="nav-menu">
      <ul class="nav-links">
        <li><a href="/tools/">Tools</a></li>
        <li><a href="/data/">Data</a></li>
        <li>
          <details class="nav-dropdown">
            <summary>Locations</summary>
            <ul>
              <li><a href="/austin/">Austin</a></li>
              <li><a href="/san-antonio/">San Antonio</a></li>
            </ul>
          </details>
        </li>
      </ul>
    </nav>
    <a class="nav-cta" href="/dashboard/">{ctaLabel}</a>
  </div>
</header>
