---
// Nav for this build (CLAUDE.md / ROADMAP.md): `Data · Locations` plus a
// persistent "My Dashboard" button. Tools and Methodology both left the
// header this round — Methodology moved to the footer, and the Tools hub is
// out of scope for this build. Services were dropped earlier and are not
// coming back. This renders on every page via Base.astro, so the change is
// sitewide, not homepage-only.
const ctaLabel = "My Dashboard";
---

<div class="topbar" id="topbar">
  <div class="wrap">
    <span>Free for homeowners &bull; No phone number required to start</span>
    <span>Austin &amp; San Antonio &bull; more Texas metros coming soon</span>
  </div>
</div>
<header class="site-nav" id="site-nav">
  <div class="wrap">
    <a class="brand-mark" href="/" aria-label="Texas Home Intelligence — home">
      <!-- The mark is a swappable asset (logo not finalized — BRAND.md):
      replace site/public/images/logo.png to change it, nothing else
      references it. Sized for its 28px header slot at 4x; the previous
      file was the 1.6 MB 1254px original, shipped twice and loaded on
      every page. The crawlable wordmark beside it stays regardless, and
      doubles as the onerror fallback so the header never shows a broken
      image. -->
      <img src="/images/logo.png" alt="" width="28" height="28" class="brand-logo" />
      <span class="brand-mark-text">Texas Home<span>Intelligence</span></span>
    </a>

    <!-- Mobile hamburger toggle — CSS-only (checkbox hack), no JS. The
    nav links below are always real <a href> in the DOM; this only ever
    toggles their CSS display, so they're crawlable and reachable via
    keyboard/screen reader regardless of viewport or JS. -->
    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Menu">&#9776;</label>

    <nav aria-label="Primary" class="nav-menu">
      <ul class="nav-links">
        <li><a href="/data/">Data</a></li>
        <li>
          <details class="nav-dropdown">
            <summary>Locations</summary>
            <ul>
              <li><a href="/austin/">Austin</a></li>
              <li><a href="/san-antonio/">San Antonio</a></li>
            </ul>
          </details>
        </li>
      </ul>
    </nav>
    {/* Both header states ship in the static HTML; the marker cookie decides
        which is shown. Logged-out is the default, so a visitor with no cookie,
        no JavaScript, or a stripped cookie still gets a working header — and
        "Sign in" is correct for them. A signed-in visitor who somehow lands on
        the logged-out header loses nothing: /home/sign-in/ redirects them
        straight to /home/ because they already hold a session. */}
    <span class="nav-actions" data-nav-signed-out>
      <a class="nav-signin" href="/home/sign-in/">Sign in</a>
      <a class="nav-cta" href="/dashboard/">{ctaLabel}</a>
    </span>
    <span class="nav-actions" data-nav-signed-in hidden>
      <a class="nav-cta" href="/home/">My Home</a>
    </span>
  </div>
</header>

<script>
  // Header state. Reads the `thi_signed_in` marker, which exists only to pick
  // between two headers that are both already in the DOM. It is not
  // authentication: the server never reads it, and forging it changes the
  // header and nothing else — every protected route still checks the HttpOnly
  // session and redirects.
  const signedIn = document.cookie.split(";").some((c) => c.trim() === "thi_signed_in=1");
  if (signedIn) {
    document.querySelectorAll<HTMLElement>("[data-nav-signed-out]").forEach((el) => (el.hidden = true));
    document.querySelectorAll<HTMLElement>("[data-nav-signed-in]").forEach((el) => (el.hidden = false));
  }

  // Logo load-failure fallback: never show a broken-image icon in the
  // header — fall back to the text wordmark instead.
  const brandLogo = document.querySelector<HTMLImageElement>(".brand-logo");
  brandLogo?.addEventListener(
    "error",
    () => brandLogo.closest(".brand-mark")?.classList.add("brand-mark--fallback"),
    { once: true },
  );

  // Compact the header on scroll (fade the nav links, collapse the
  // announcement bar) so the sticky header takes less vertical space
  // once the visitor is reading content below it — most valuable on
  // mobile, where every pixel of a persistent sticky header competes
  // with the viewport. The header's own height never changes; this only
  // ever hides/fades content that sits above or beside it.
  const SCROLL_THRESHOLD = 12;
  let ticking = false;
  function updateScrolledState() {
    document.body.classList.toggle("is-scrolled", window.scrollY > SCROLL_THRESHOLD);
    ticking = false;
  }
  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        requestAnimationFrame(updateScrolledState);
        ticking = true;
      }
    },
    { passive: true },
  );
  updateScrolledState();
</script>
