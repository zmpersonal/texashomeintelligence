---
/**
 * "City services" — municipal schedules on the logged-in dashboard.
 *
 * v2 arrangement: three labelled rows in one panel, each with a status chip on
 * the right, and a counter at the top saying how many are shown. The states are
 * exactly the states Round 5b built — this changes how they look, not when they
 * fire or what they claim.
 *
 * Information ladder: everything here is the **Data** rung. A collection day is
 * a fact about the address, not advice, so there is no Recommendation rung and
 * no action verbs — the honesty guard that applies to signals applies here by
 * simply having no actions to guard.
 *
 * Withholds are designed, not empty. Each withheld row keeps its label, gets a
 * slate "Not shown" chip, states the reason in plain language, and offers a
 * route forward. Nothing looks like a failed load, and nothing implies a date
 * we do not have. That is the whole point of the treatment: a reader must be
 * able to tell "we checked and cannot say" apart from "this is broken".
 */
import { formatDate, machineDate } from "../lib/format";
import type { CollectionResult } from "../lib/municipal/match";
import type { WateringView } from "../lib/municipal/watering";
import {
  ARR_MY_SCHEDULE_URL, ARR_SOURCE, AUSTIN_WATER_FIND_DAY_URL,
  AUSTIN_WATER_SOURCE, BULK_POLICY,
} from "../lib/municipal/config";

interface Props {
  collection: CollectionResult;
  watering: WateringView;
  areaId: string;
}
const { collection, watering, areaId } = Astro.props;
const isAustin = areaId === "austin";

/** Why a collection reading is withheld, in the reader's terms. Each one says
 * what we could not establish — never "unavailable" with no reason. */
const WITHHELD_COPY: Record<string, string> = {
  "not-austin":
    "Municipal collection schedules are Austin-only for now. We don't have a verified schedule source for your area yet.",
  "no-address":
    "Add your street address to see your collection day. Readings without one would be for the ZIP, and a ZIP can span several collection days.",
  "zip-not-served":
    "Austin Resource Recovery doesn't list a collection schedule for this ZIP. Your home is likely served by another provider.",
  "address-not-found":
    "We couldn't find this address in Austin Resource Recovery's schedule. That usually means another provider collects here — or the address is written differently in the city's records.",
  ambiguous:
    "Austin Resource Recovery lists more than one schedule for this address, and we can't tell which applies to your unit.",
  unparsed:
    "We couldn't read this address confidently enough to match it against the city's schedule.",
  malformed:
    "The city's schedule record for this address wasn't in a form we could read.",
};

// The counter at the top of the panel. Bulk only counts as a row at all in
// Austin; elsewhere the whole panel is the not-covered state.
const rows = isAustin ? 3 : 2;
const shown =
  (collection.status === "found" ? 1 : 0) +
  (watering.status === "current" || watering.status === "stale" ? 1 : 0) +
  (isAustin ? 1 : 0);
const notShown = rows - shown;
---

<section class="card citysvc" data-municipal aria-labelledby="citysvc-h">
  <header class="citysvc-head">
    <h3 id="citysvc-h">City services</h3>
    <p class="data-meta citysvc-count" data-citysvc-count>
      {notShown > 0 && <>{notShown} not shown · </>}{shown} shown
    </p>
  </header>
  <p class="citysvc-intro">
    We show a date only when a city source gives us one for this address.
  </p>

  {/* ── Trash & recycling ─────────────────────────────────────────── */}
  <div class="citysvc-row" data-muni-collection data-status={collection.status}>
    <div class="citysvc-row-head">
      <p class="citysvc-label">Trash &amp; recycling</p>
      {collection.status === "found" ? (
        <span class="citysvc-chip citysvc-chip--shown" data-collection-day>{collection.day}</span>
      ) : (
        <span class="citysvc-chip citysvc-chip--withheld" data-collection-withheld>Not shown</span>
      )}
    </div>

    {collection.status === "found" ? (
      <>
        <p class="citysvc-read">
          Austin Resource Recovery collects trash weekly on this day. Recycling is collected every
          other week, and this address is on{" "}
          <strong data-collection-week>Week {collection.week}</strong>.
        </p>
        <p class="citysvc-read citysvc-caveat">
          We publish the week your address is on, not a date — the city's calendar is what says
          which week is running now.{" "}
          <a href={ARR_MY_SCHEDULE_URL} rel="nofollow noopener" target="_blank">See the city's calendar</a>
        </p>
        <p class="data-meta muni-source">
          Source: {ARR_SOURCE.name}
          {collection.sourceUpdatedAt && (
            <>
              {" "}· Data through{" "}
              <time datetime={machineDate(collection.sourceUpdatedAt)}>{formatDate(collection.sourceUpdatedAt)}</time>
            </>
          )}
          {" "}· Updated{" "}
          <time datetime={machineDate(collection.ingestedAt)}>{formatDate(collection.ingestedAt)}</time>
        </p>
      </>
    ) : (
      <div class="citysvc-withheld">
        <p class="citysvc-read">{WITHHELD_COPY[collection.reason]}</p>
        {collection.reason !== "not-austin" && (
          <p class="citysvc-read">
            <a href={ARR_MY_SCHEDULE_URL} rel="nofollow noopener" target="_blank">
              Look your address up on the city's tool &rarr;
            </a>
          </p>
        )}
      </div>
    )}
  </div>

  {/* ── Watering ──────────────────────────────────────────────────── */}
  <div class="citysvc-row" data-muni-watering data-status={watering.status}>
    <div class="citysvc-row-head">
      <p class="citysvc-label">Watering</p>
      {watering.status === "unavailable" ? (
        <span class="citysvc-chip citysvc-chip--withheld">Not shown</span>
      ) : (
        <span
          class={`citysvc-chip ${watering.status === "stale" ? "citysvc-chip--stale" : "citysvc-chip--shown"}`}
          data-water-stage
        >{watering.stage}</span>
      )}
    </div>

    {watering.status === "unavailable" ? (
      <div class="citysvc-withheld">
        <p class="citysvc-read">
          {watering.reason === "not-austin"
            ? "Austin Water's restrictions are Austin-only. We don't have a verified restriction source for your area yet."
            : "We don't have a current reading of Austin Water's restriction stage."}
          {watering.reason !== "not-austin" && (
            <>
              {" "}If you're an Austin Water customer,{" "}
              <a href={AUSTIN_WATER_FIND_DAY_URL} rel="nofollow noopener" target="_blank">their site has today's stage</a>.
            </>
          )}
        </p>
      </div>
    ) : (
      <>
        {watering.status === "stale" && (
          <p class="citysvc-stale" data-water-stale>
            Last confirmed{" "}
            <time datetime={machineDate(watering.observedAt)}>{formatDate(watering.observedAt)}</time>{" "}
            — {watering.ageDays} days ago. We're showing the last stage we verified, and we're not
            publishing a watering day from it: the day each address waters changes with the stage.
          </p>
        )}

        {watering.status === "current" && watering.rule && (
          <>
            {watering.automaticDay ? (
              <p class="citysvc-read" data-water-day>
                <strong>If your home is an Austin Water customer</strong>, addresses ending in an{" "}
                {watering.parity} number water on <strong>{watering.automaticDay}</strong> with an
                automatic irrigation system. {watering.hoseEndDay
                  ? `Hose-end sprinklers: ${watering.hoseEndDay}.`
                  : watering.rule.hoseEndNote}
              </p>
            ) : (
              <p class="citysvc-read">
                <strong>If your home is an Austin Water customer</strong>, your watering day follows
                your street number — we couldn't read one from your address, so we're not stating a day.
              </p>
            )}
            <p class="citysvc-read">{watering.rule.hours}</p>
            <p class="citysvc-read citysvc-caveat">
              Austin Water's service area doesn't match city or county lines, so we can't confirm
              from your address alone whether these rules apply to your home.{" "}
              <a href={AUSTIN_WATER_FIND_DAY_URL} rel="nofollow noopener" target="_blank">
                Check your watering day with Austin Water
              </a>
            </p>
          </>
        )}

        {watering.status === "current" && !watering.rule && (
          <p class="citysvc-read">
            We don't have the watering rule for this stage on file, so we're not stating a day.{" "}
            <a href={AUSTIN_WATER_FIND_DAY_URL} rel="nofollow noopener" target="_blank">
              Check your watering day with Austin Water
            </a>
          </p>
        )}

        <p class="data-meta muni-source">
          Source: {AUSTIN_WATER_SOURCE.name} · Reading from{" "}
          <time datetime={machineDate(watering.observedAt)}>{formatDate(watering.observedAt)}</time>
        </p>
      </>
    )}
  </div>

  {/* ── Bulk ──────────────────────────────────────────────────────── */}
  {isAustin && (
    <div class="citysvc-row" data-muni-bulk>
      <div class="citysvc-row-head">
        <p class="citysvc-label">Bulk &amp; brush</p>
        <span class="citysvc-chip citysvc-chip--shown" data-bulk-entitlement>
          {BULK_POLICY.collectionsPerYear} pickups a year
        </span>
      </div>
      <p class="citysvc-read">
        Austin collects bulk, brush and household hazardous waste by appointment rather than on a
        set schedule, so there's no date to show. Each service address gets{" "}
        {BULK_POLICY.collectionsPerYear} collections per service, per year, booked through 311 or
        the Austin Recycles app.
      </p>
      <p class="data-meta muni-source">
        Source: {BULK_POLICY.source.name} · On-demand since{" "}
        <time datetime={machineDate(BULK_POLICY.asOf)}>{formatDate(BULK_POLICY.asOf)}</time>
      </p>
    </div>
  )}
</section>
