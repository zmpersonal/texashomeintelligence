---
import { getCollection } from "astro:content";

const services = await getCollection("services");
const serviceOrder = [
  "roofing",
  "hvac",
  "plumbing",
  "fire-damage-restoration",
  "mold-remediation",
  "electrical",
  "tree-trimming",
];
const orderedServices = serviceOrder
  .map((slug) => services.find((s) => s.id === slug))
  .filter((s) => s !== undefined);

/**
 * Round 33. Social profiles, as a list rather than one hardcoded anchor, so
 * adding YouTube or Pinterest later is a line here and nothing else.
 *
 * A profile ships only when its URL is REAL. There is no placeholder entry and
 * no "#" — an icon pointing at a profile that does not exist is a broken
 * promise on all 272 pages, and a guessed URL is worse than a missing icon.
 * Facebook is the only account confirmed by the owner this round.
 *
 * The mark is the official Facebook glyph, inline and single-path, drawn in
 * `currentColor` so it inherits the footer's on-dark text colour. No icon font
 * and no third-party script: a footer icon is not worth a request to someone
 * else's CDN, and a social script on every page is a tracking surface.
 */
const socialProfiles = [
  {
    name: "Facebook",
    href: "https://www.facebook.com/people/Texas-Home-Intelligence/61593991198459/",
    // Official f-in-circle mark, unaltered, 24x24.
    path: "M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z",
  },
  {
    name: "Pinterest",
    href: "https://www.pinterest.com/texasintelligence/",
    // Official P-in-circle mark, unaltered, 24x24.
    path: "M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z",
  },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <h4>Texas Home Intelligence</h4>
        <p class="footer-blurb">
          Continuously updated local home intelligence for Texas homeowners —
          weather and storm exposure, permit activity, drought and energy
          costs for Austin, San Antonio, and beyond. Every reading shows its
          source and how current it is.
        </p>
        <h4 class="footer-connect-heading">Connect</h4>
        <ul class="footer-social">
          {socialProfiles.map((profile) => (
            <li>
              <a
                class="footer-social-link"
                href={profile.href}
                rel="me noopener"
                aria-label={`Texas Home Intelligence on ${profile.name}`}
              >
                <svg
                  viewBox="0 0 24 24"
                  width="20"
                  height="20"
                  fill="currentColor"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d={profile.path} />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
      {/* Round 33: Locations folded into Company. Austin and San Antonio are
          the two metros the site covers, not a category of their own, and the
          column they had to themselves carried two links against the grid's
          full row height — 67% of it empty at 1366px, measured.

          Round 29 put Tools here and the reason still holds, so it stays:
          /tools/ was an INDEXED ORPHAN — measured across every built page, the
          only inbound links it had came from the breadcrumbs of its own three
          children. Re-measured before this round: 3 inbound sources outside the
          footer, ALL of them its own children. Remove this link and the hub and
          the three tools behind it go back to hanging off nothing. Tools stays
          OUT of the header nav, which CLAUDE.md fixes at Data, Analysis,
          Locations and My Dashboard. */}
      <div>
        <h4>Company</h4>
        <ul>
          <li><a href="/austin/">Austin</a></li>
          <li><a href="/san-antonio/">San Antonio</a></li>
          <li><a href="/tools/">Tools</a></li>
          <li><a href="/home/sign-in/">Sign in</a></li>
          <li><a href="/dashboard/">My Dashboard</a></li>
        </ul>
      </div>
      {/* Round 10b: the "All services" link to /services/ is gone. ROADMAP is
          explicit — Services is permanently removed from nav and must not be
          re-added or linked — and this footer link was the last piece of chrome
          re-adding it. The individual location x service links STAY: those are
          the fourteen indexed content pages, and dropping them would cut a
          third of the site's internal linking to nothing (KPI #1). The column
          heading describes what the links are, not a hub. */}
      <div>
        <h4>Services</h4>
        <ul>
          {orderedServices.map((svc) => (
            <li><a href={`/austin/${svc.id}/`}>{svc.data.name}</a></li>
          ))}
        </ul>
      </div>
      {/* Round 33: the published-surfaces column, split out of Company. The
          two metro links are ANCHORS INTO /data/, not location hubs — no
          /data/austin/ hub page is claimed here, and the ids they target are
          emitted by the catalog's own loop over the registry rather than
          written down, so a location that stops publishing takes its anchor
          with it. */}
      <div>
        <h4>Data</h4>
        <ul>
          <li><a href="/data/">Data Catalog</a></li>
          <li><a href="/analysis/">Analysis</a></li>
          <li><a href="/methodology/">Methodology</a></li>
          <li><a href="/data/#austin">Austin Data</a></li>
          <li><a href="/data/#san-antonio">San Antonio Data</a></li>
          <li><a href="/privacy/">Privacy</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      &copy; {new Date().getFullYear()} Texas Home Intelligence. Our readings
      organize public data and homeowner-reported information &mdash; they are
      not an inspection, diagnosis, or professional evaluation.
    </div>
  </div>
</footer>
