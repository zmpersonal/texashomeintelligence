---
/**
 * The data catalog. Both the visible list and the DataCatalog schema are
 * generated from the published-page registry, so they cannot drift apart —
 * this page previously hand-maintained a one-element schema array and a
 * hardcoded SAMPLE badge that stayed put after the feed behind it went live.
 */
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import DataStatus from "../../components/DataStatus.astro";
import { getCollection } from "astro:content";
import { publishedDataPages } from "../../lib/dataPages";
import { findDataset, freshnessOf } from "../../lib/datasets";

const locations = await getCollection("locations");
const locationOrder = ["austin", "san-antonio"];
const orderedLocations = locationOrder
  .map((id) => locations.find((l) => l.id === id))
  .filter((l) => l !== undefined);

const title = "Texas Homeowner Data Catalog | Texas Home Intelligence";
const description =
  "The statewide catalog of local homeowner data Texas Home Intelligence tracks, by location and topic — each dataset published with its source, coverage window and last-confirmed date.";

const published = publishedDataPages().map((spec) => {
  const dataset = findDataset(spec.datasetId, spec.location)!;
  return { spec, dataset, freshness: freshnessOf(dataset) };
});

const datasetJsonLd = {
  "@context": "https://schema.org",
  "@type": "DataCatalog",
  "@id": new URL("/data/", Astro.site).toString() + "#catalog",
  name: "Texas Home Intelligence Homeowner Data Catalog",
  description,
  url: new URL("/data/", Astro.site).toString(),
  publisher: { "@id": `${Astro.site?.toString().replace(/\/$/, "") ?? ""}/#organization` },
  dataset: published.map(({ spec }) => ({
    "@type": "Dataset",
    name: spec.datasetName,
    description: spec.datasetDescription,
    url: new URL(`/data/${spec.location}/${spec.topic}/`, Astro.site).toString(),
  })),
};
---

<Base title={title} description={description}>
  <Breadcrumbs crumbs={[{ name: "Home", url: "/" }, { name: "Data", url: "/data/" }]} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(datasetJsonLd)} />

  <section class="hero">
    <div class="wrap" style="max-width:760px;">
      <h1>Texas Homeowner Data Catalog</h1>
      <p class="lede">
        A statewide index of the local homeowner data Texas Home Intelligence tracks. Each entry
        links to a stable, source-attributed data page whose figures are computed from the
        underlying records and published alongside it as CSV.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap" style="max-width:760px;">
      <h2>By location</h2>
      <div class="grid-2">
        {orderedLocations.map((loc) => {
          const forLocation = published.filter(({ spec }) => spec.location === loc.id);
          return (
            <div class="card">
              <h3>{loc.data.name}</h3>
              <p>
                Weather &amp; storm exposure, permit activity, drought conditions, and more for{" "}
                {loc.data.counties}.
              </p>
              {forLocation.length > 0 ? (
                <>
                  <p><a href={`/data/${loc.id}/`}>All {loc.data.name} data &rarr;</a></p>
                  <ul>
                    {forLocation.map(({ spec, dataset, freshness }) => (
                      <li>
                        <a href={`/data/${spec.location}/${spec.topic}/`}>{spec.h1}</a>
                        <DataStatus
                          status={dataset.status}
                          asOf={freshness.asOf}
                          dataThrough={freshness.dataThrough}
                          source={dataset.source.name}
                        />
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <p style="color:var(--ink-soft);font-size:0.9rem;">
                  No data pages published yet for {loc.data.name}.
                </p>
              )}
            </div>
          );
        })}
      </div>

      <h2 style="margin-top:32px;">How to read a data page</h2>
      <p>
        Every data page separates observed <strong>Data</strong> from{" "}
        <strong>THI Interpretation</strong>, shows how far its records run and when the feed was
        last confirmed, and links to our <a href="/methodology/">methodology</a>. Estimates are
        labeled as estimates with a range. If a feed stops updating we keep the last confirmed
        values and mark them stale rather than showing zero.
      </p>
    </div>
  </section>
</Base>
