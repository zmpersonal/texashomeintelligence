---
import Base from "../../../../layouts/Base.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import DataStatus from "../../../../components/DataStatus.astro";
import type { DatasetFile } from "../../../../ingest/types";
import type { StormEventValue } from "../../../../ingest/fetchers/noaaStormEvents";
// Real ingestion output (src/ingest/**, .github/workflows/data-ingestion.yml)
// — not hand-typed sample rows. Every field below is read from the
// normalized dataset file, never a raw API shape (CLAUDE.md). Until Seam
// 1's fetchRaw() is implemented this stays "sample"; the moment a real
// fetch succeeds, `stormData.status` flips to "live" and this page
// updates with no code change.
import stormDataRaw from "../../../../data/generated/noaa-storm-events/austin.json";
const stormData = stormDataRaw as DatasetFile<StormEventValue>;

const title = "Austin Roofing Data: Hail & Storm Events | Texas Home Intelligence";
const description =
  "Current and historical hail and wind event data for Austin, TX, and what it may mean for roofing decisions.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: "Austin, TX Hail & Wind Storm Events (Roofing Context)",
  description:
    "Recorded hail and wind storm events for the Austin, TX metro, used as roofing-decision context.",
  temporalCoverage: stormData.status === "sample" ? "SAMPLE" : `${stormData.observations[0]?.observedAt ?? ""}/${stormData.observations.at(-1)?.observedAt ?? ""}`,
  spatialCoverage: { "@type": "Place", name: "Austin, Texas" },
  creator: { "@type": "Organization", name: "Texas Home Intelligence" },
  distribution: [
    {
      "@type": "DataDownload",
      encodingFormat: "text/csv",
      contentUrl: new URL("/data/austin/roofing/hail-events.csv", Astro.site).toString(),
    },
  ],
};

const trailing12mo = (() => {
  const cutoff = Date.now() - 365 * 86_400_000;
  return stormData.observations.filter((o) => new Date(o.observedAt).getTime() >= cutoff);
})();

const largestHailInches = trailing12mo
  .filter((o) => o.value.eventType === "Hail")
  .map((o) => parseFloat(o.value.magnitude))
  .filter((n) => !Number.isNaN(n))
  .reduce((max, n) => Math.max(max, n), 0);

const events = [...stormData.observations]
  .sort((a, b) => b.observedAt.localeCompare(a.observedAt))
  .map((o) => ({
    date: new Date(o.observedAt).toLocaleDateString("en-US", { year: "numeric", month: "short" }),
    type: o.value.eventType,
    size: o.value.magnitude,
    area: o.value.county,
  }));

const badgeStatus = stormData.status;
const asOf = stormData.status === "sample" ? undefined : (stormData.lastSuccessAt ?? undefined);
---

<Base title={title} description={description}>
  <Breadcrumbs
    crumbs={[
      { name: "Home", url: "/" },
      { name: "Data", url: "/data/" },
      { name: "Austin", url: "/data/" },
      { name: "Roofing — Hail & Storm Events", url: "/data/austin/roofing/" },
    ]}
  />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <section class="hero">
    <div class="wrap" style="max-width:820px;">
      <span class="eyebrow">AUSTIN &bull; ROOFING DATA</span>
      <h1>Austin Hail &amp; Wind Storm Events</h1>
      <p class="lede">
        Recent hail and wind history for the Austin metro, and what it may mean for roof age,
        damage likelihood, and quote timing.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="grid-3">
        <div class="card data-card">
          <DataStatus status={badgeStatus} asOf={asOf} source={stormData.source.name} />
          <p class="metric-label" style="margin-top:8px;">Reported hail/wind events, trailing 12 months</p>
          <p style="font-size:1.6rem;font-weight:800;margin:6px 0 0;">{trailing12mo.length}</p>
        </div>
        <div class="card data-card">
          <DataStatus status={badgeStatus} asOf={asOf} source={stormData.source.name} />
          <p class="metric-label" style="margin-top:8px;">Largest reported hail size</p>
          <p style="font-size:1.6rem;font-weight:800;margin:6px 0 0;">
            {largestHailInches > 0 ? `${largestHailInches.toFixed(2)}″` : "No hail reported"}
          </p>
        </div>
        <div class="card data-card">
          <DataStatus status={badgeStatus} asOf={stormData.lastAttemptAt ?? undefined} source={stormData.source.name} />
          <p class="metric-label" style="margin-top:8px;">Live feed connection</p>
          {stormData.lastError && (
            <p style="font-size:0.78rem;color:var(--ink-soft);margin-top:4px;">{stormData.lastError}</p>
          )}
        </div>
      </div>
      <p class="data-meta">
        Measures: county-level hail and wind storm reports. Geography: Travis County (Austin metro
        proxy). Reporting period: trailing 12 months, updated monthly once connected. Source: NOAA
        Storm Events Database.
      </p>
    </div>
  </section>

  <section class="block alt">
    <div class="wrap" style="max-width:900px;">
      <h2>Recent Reported Events</h2>
      <table class="data-table">
        <thead>
          <tr><th>Date</th><th>Event type</th><th>Reported size / gust</th><th>Area affected</th></tr>
        </thead>
        <tbody>
          {events.map((e) => (
            <tr><td>{e.date}</td><td>{e.type}</td><td>{e.size}</td><td>{e.area}</td></tr>
          ))}
        </tbody>
      </table>
      <p>
        <a href="/data/austin/roofing/hail-events.csv">Download as CSV</a>{" "}
        {stormData.status === "sample" && <span class="sample-badge">SAMPLE</span>}
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap" style="max-width:760px;">
      <h2>THI Interpretation</h2>
      <p><strong>Data:</strong> the table above reflects storm events reported for the Austin area over the trailing period shown.</p>
      <p><strong>THI Interpretation:</strong> repeated hail events at or above roughly one inch are a common trigger for insurance-eligible roof damage, so homes in affected areas may benefit from a professional roof inspection even without an obvious leak.</p>
      <p><strong>What this may mean for homeowners:</strong> if your property falls within an affected area and time window, it can be worth requesting a roof inspection and comparing quotes with a <a href="/austin/roofing/">QuoteReady Roofing Brief</a> before the next storm season.</p>
      <p><strong>Limitations:</strong> storm event reports are recorded at the county or station level, not the individual address, and do not confirm damage to any specific roof. This page currently shows placeholder SAMPLE data; no live feed is connected yet.</p>
    </div>
  </section>

  <section class="block alt">
    <div class="wrap" style="max-width:760px;">
      <h2>Methodology</h2>
      <p>
        Planned source: NOAA Storm Events Database, filtered to Travis County. Update cadence:
        monthly. If a scheduled update fails, the prior valid values will be preserved and marked
        stale with the last successful update date, rather than showing zero or blank. See our
        full <a href="/methodology/">methodology</a> page for how we handle stale data, historical
        observations, and source attribution across the site.
      </p>
    </div>
  </section>
</Base>
