---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import DataStatus from "../../components/DataStatus.astro";
import { getCollection } from "astro:content";
import { findDataset, freshnessOf, type DisplayStatus } from "../../lib/datasets";
import { ZIP_AREAS } from "../../data/zip-areas";

const title = "Methodology | Texas Home Intelligence";
const description =
  "How Texas Home Intelligence sources, updates, labels, and limits the local data it publishes — including every public source we track and its current state.";

/**
 * The source registry, rendered from `src/data/data-sources.yaml` rather than
 * re-typed in prose. The page used to list these sources in a hand-written
 * paragraph while the collection sat unread, so the two could drift apart.
 *
 * Each row's state comes from the generated dataset files, not from the YAML's
 * own `status` field — that field is maintained by hand and is exactly the
 * kind of thing that goes stale once a feed changes.
 */
const sources = await getCollection("dataSources");
// Round 40. Was a hardcoded list, so a third metro's feeds would have been
// missing from every status badge on this page. Derived from the config, plus
// "texas" — the statewide data hub, which is not a ZIP area and has no entry.
const LOCATIONS = [...ZIP_AREAS.map((a) => a.areaId), "texas"];

/** Least to most severe, for reducing a multi-location source to one badge. */
const DISPLAY_SEVERITY: DisplayStatus[] = [
  "current",
  "out-of-date",
  "feed-down",
  "unavailable",
  "sample",
];

const sourceRows = sources.map((entry) => {
  const datasets = LOCATIONS.map((loc) => findDataset(entry.data.id, loc)).filter(
    (d) => d !== undefined,
  );
  const live = datasets.filter((d) => d.status === "live");
  const stale = datasets.filter((d) => d.status === "stale");
  const newest = datasets
    .map((d) => d.lastSuccessAt)
    .filter((v): v is string => Boolean(v))
    .sort()
    .at(-1);
  // The OLDEST record across this source's files — the one that decides the
  // badge, so it is also the one the row must show. Without it a row could
  // read "OUT OF DATE · Last checked: today" and leave the reader with no way
  // to see how old the data actually is.
  const oldestThrough = datasets
    .map((d) => freshnessOf(d).dataThrough)
    .filter((v): v is string => Boolean(v))
    .sort()
    .at(0);
  const status: "live" | "stale" | "sample" =
    live.length > 0 ? "live" : stale.length > 0 ? "stale" : "sample";
  // One row covers a source across every location it publishes for, so the
  // row reports its WORST state: a source that is current in Austin and out
  // of date in San Antonio is not simply "current". `display` is resolved
  // per file, then reduced by severity.
  const display = datasets
    .map((d) => freshnessOf(d).display)
    .sort((a, b) => DISPLAY_SEVERITY.indexOf(b) - DISPLAY_SEVERITY.indexOf(a))
    .at(0);
  return {
    ...entry.data,
    status,
    display: display ?? "sample",
    asOf: status === "sample" ? undefined : newest,
    dataThrough: status === "sample" ? undefined : oldestThrough,
    connected: datasets.length > 0,
  };
});

const connectedCount = sourceRows.filter((r) => r.status === "live").length;
// The page's own content moves when a feed's state changes, so the newest
// successful fetch is an honest dateModified for it.
const dateModified = sourceRows
  .map((r) => r.asOf)
  .filter((v): v is string => Boolean(v))
  .sort()
  .at(-1);
---

<Base
  title={title}
  description={description}
  article={{ dateModified, section: "Methodology" }}
>
  <Breadcrumbs crumbs={[{ name: "Home", url: "/" }, { name: "Methodology", url: "/methodology/" }]} />

  <section class="hero">
    <div class="wrap" style="max-width:760px;">
      <h1>Methodology</h1>
      <p class="lede">
        How we source, update, and label the local data behind Texas Home Intelligence, and what
        it does and doesn't tell you.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap" style="max-width:760px;">
      <h2>What this page covers</h2>
      <p>
        Texas Home Intelligence publishes a continuously updated layer of local homeowner data
        and plain-language interpretation, plus free homeowner tools. This page explains how the
        data layer works: where each figure comes from, how often it refreshes, and what we do
        when a source fails.
      </p>

      <h2>Where does Texas Home Intelligence get its data?</h2>
      <p>
        Every figure comes from a named public source, and every page states what it measures,
        its geography, its reporting period, and when the feed was last confirmed. We track{" "}
        {sourceRows.length} public sources; {connectedCount} are currently connected and live.
        The table below is generated from our source registry, so it reflects the real state of
        each feed rather than a description of it.
      </p>
      <div class="table-scroll">
        <table class="data-table">
          <caption>Every public data source Texas Home Intelligence tracks, and its current state.</caption>
          <thead>
            <tr>
              <th scope="col">Source</th>
              <th scope="col">Published by</th>
              <th scope="col">What it provides</th>
              <th scope="col">State</th>
            </tr>
          </thead>
          <tbody>
            {sourceRows.map((row) => (
              <tr>
                <td>{row.name}</td>
                <td>{row.org}</td>
                <td>{row.thiOutput}</td>
                <td>
                  {row.connected && row.status !== "sample" ? (
                    <DataStatus status={row.display} asOf={row.asOf} dataThrough={row.dataThrough} />
                  ) : (
                    <span class="sample-badge">Not yet connected</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2>Public / Observed Data vs. Historical Context vs. THI Analysis</h2>
      <p>
        We separate what a source actually reported (<strong>Public / Observed Data</strong>) from
        how that compares to prior conditions or seasonal norms (<strong>Historical
        Context</strong>) from our own plain-language read of what it might mean for homeowners
        (<strong>THI Analysis</strong>). Modeled estimates and anything a homeowner tells us
        directly are labeled as <strong>Estimates &amp; Homeowner Information</strong>, never
        presented as an observed fact.
      </p>

      <h2>Stale and failed data</h2>
      <p>
        If a source feed fails or returns nothing useful, we do not silently show a zero or blank
        value as if it were current. We preserve the last known valid figure and mark it as stale,
        with the date it was last confirmed. If no valid value has ever been obtained, we say so
        explicitly rather than substituting a fabricated number.
      </p>

      <h2>How often does the data update?</h2>
      <p>
        Ingestion runs on a schedule and appends to an archive rather than replacing it. Several
        sources publish on their own lag — NOAA's storm reports run months behind the events they
        describe, and the EIA revises recent months as utilities report — so each page shows two
        separate dates: how far the records themselves run, and when we last confirmed the feed.
        Collapsing those into one "updated" date would overstate how current the data is.
      </p>

      <h2>Historical observations</h2>
      <p>
        Where practical, we store historical values rather than overwriting the previous number, so
        a data page can show a trend, not just a snapshot.
      </p>

      <h2>Do you ever publish placeholder numbers?</h2>
      <p>
        No. Sources we have not connected yet are listed above as
        <strong>Not yet connected</strong> and carry no figures at all. Published data pages
        contain no placeholder rows: a page is only built once its feed has returned real
        records, and the fabricated rows used to bootstrap a dataset during development are
        retired from it the first time a real fetch succeeds. That retirement failed once, in
        August 2026, and we published a figure that had never been measured &mdash; see below.
      </p>

      <h2>Have you ever published a number that was wrong?</h2>
      <p>Yes. Twice, and these are the records of them.</p>

      <h3>28 August &ndash; 1 October 2026 &mdash; a placeholder electricity price published as a measurement</h3>
      <p>
        From 28 August to 1 October 2026, the Texas residential electricity price shown on this
        site &mdash; 13.88&cent; per kilowatt-hour, labelled August 2026 and sourced to the U.S.
        Energy Information Administration &mdash; was not a measured figure. It was a placeholder
        written while the dataset was being set up, which should have been discarded the first time
        the real feed succeeded and was not. The real series had stopped at 16.44&cent; in May
        2026, and the placeholder sat on top of it, so the page also showed a LIVE badge over a
        feed that was four months stale.
      </p>
      <p>
        It first appeared on 28 August, on the Texas electricity price page and its downloadable
        CSV, the day that page was published. From there it reached the homepage, both HVAC pages,
        the AC lifespan tool, and one analysis article. Because the placeholder values ran about
        2.5&cent; below the real ones, the published series read as a sharp recent fall in prices.
        It was not one &mdash; the drop a reader saw was the 2.5&cent; gap between the placeholder
        and the real series, not a movement in the price, and nothing in this record is a claim
        about how the price has moved since. <strong>Texas residential electricity prices did not fall as the
        published series suggested. Over the ten months the real data covered at the time of this
        correction, they rose 6.3%, from 15.46&cent; in August 2025 to 16.44&cent; in May
        2026.</strong> The current series is on the{" "}
        <a href="/data/texas/electricity-prices/">Texas electricity prices page</a>.
      </p>
      <p>What we have done about it:</p>
      <ul class="key-findings">
        <li>
          <strong>The placeholder rows no longer publish a figure</strong> &mdash; seven removed
          and three relabelled as placeholders, across seven datasets. Every page that carried the
          figure was rebuilt from the real series, and the electricity feed's badge is resolved from
          the age of the data rather than from whether the fetch succeeded, which at the time of
          this correction made it <strong>Out of date</strong>.
        </li>
        <li>
          <strong>The article built on the figure has been withdrawn</strong>, not corrected. Its
          central claim could not be restated: the month it reported on does not exist in the data,
          and the ten-month series it had could not support the year-over-year comparison it led
          with. Its URL returns 410 Gone.
        </li>
        <li>
          <strong>The detection is now a test that runs on every build.</strong> The old check
          tried to recognise a placeholder by what it looked like, and these rows did not look like
          one. The new one regenerates what the placeholder generator would have written and
          matches it exactly, so a placeholder cannot reach a published page without failing the
          build. The test also proves itself each run, by re-running the old check and confirming
          it still misses rows the new one catches.
        </li>
      </ul>

      <h3>September &ndash; October 2026 &mdash; San Antonio permit counts counted records, not permits</h3>
      <p>
        Until 1 October 2026, the San Antonio permit figures on this site counted rows in the
        city's file rather than permits. The city lists one permit on several rows when it covers
        more than one type or stage, so the counts were too high. The figures were real and
        sourced; the arithmetic over them was wrong.
      </p>
      <p>
        The page it mattered on is <a href="/san-antonio/plumbing/">San Antonio plumbing</a>, which
        from 4 September to 1 October 2026 said the city issued about <strong>2,040</strong>
        plumbing permits a month and <strong>26,515</strong> over the thirteen months to September
        2026. The correct figures are <strong>1,891 a month and 24,587</strong> &mdash; about 7%
        lower. The same page described activity as flat, and still does: it read as a 0.5% rise between
        the two halves of the window and reads as a 1.6% rise now. No claim on any published page
        changed. The error could have changed one &mdash; in electrical, a trade we publish no page
        for, counting permits instead of rows turns a 4% fall into no trend at all &mdash; but on
        the pages a reader can open, it did not.
      </p>
      <p>
        San Antonio's HVAC and re-roof pages moved by about 1% in the other direction.
        Austin's counting was never wrong &mdash; its records are one row per permit &mdash; but its
        figures moved by under 1% too, from a second fix shipped alongside this one: the whole
        window is now recounted on every run, so permits the city adds to a month we have already
        counted are no longer missed.
      </p>
      <p>
        We are recording this rather than quietly correcting it for one reason in particular.
        <strong>The city's file cannot be downloaded by an ordinary script</strong> &mdash; it
        refuses the request &mdash; so nobody outside could have checked these numbers against the
        source. A site that asks to be trusted on its sourcing does not get to fix a figure nobody
        could have verified without saying so.
      </p>
      <p>
        What has changed: both cities' permit counts now read the permit number and count each
        permit once; the method note on every permit page says so; a test fails the build if the
        counting reverts; and the whole thirteen-month window is recomputed on every run, so no
        month can be left on an older method.
      </p>

      <h2>How is the Home Stress Index calculated?</h2>
      <p>
        The Home Stress Index combines five signals &mdash; Roof &amp; Storm, Foundation &amp; Soil,
        HVAC, Water &amp; Irrigation, and Trees &amp; Yard &mdash; into a single 0&ndash;100 reading
        for an area. Its weights, bands, storm-decay curve, sources, and the inputs we deliberately
        leave out are all published on its own page:
        <a href="/methodology/home-stress-index/">the Home Stress Index methodology</a>.
      </p>

      <h2>Not a substitute for professional evaluation</h2>
      <p>
        Nothing on Texas Home Intelligence is an inspection, a diagnosis, or a substitute for a
        licensed professional&rsquo;s on-site evaluation. Our readings describe conditions
        recorded across an area; they cannot confirm the state of any individual property.
      </p>
    </div>
  </section>
</Base>
