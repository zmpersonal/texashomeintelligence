---
/**
 * /home/ — the logged-in home dashboard, v2 layout.
 *
 * Four tiers, not one stack — the ordering is the design's argument:
 *
 *   status   the score, its band, the delta, and who is signed in
 *   act      what holds right now (condition card), what is due (this week),
 *            and what the city does or does not tell us — side by side
 *   read     the five signals as one aligned instrument table
 *   keep     memory, seasonal guidance, alert preferences, account
 *
 * The previous layout gave all six blocks equal weight down a single column,
 * which made the page long and flat. Nothing here is new information: this is
 * the same data, the same conditionals, and the same withhold rules, arranged
 * so the score and the actions land above the detail.
 *
 * Scores and signals are the SAME precomputed Round 3/4 output the public ZIP
 * page renders — no recomputation, no request-time fetch. The only per-request
 * database work is the account's own reminders and preferences.
 *
 * noindex: this is a personal view. The public ZIP layer is the indexed asset.
 *
 * Every state the page can be in is rendered, not just the one the mockup drew:
 * a withheld collection day, a stale water stage, a signal with no series, a
 * signal not published for the area, an empty reminder queue, no fired
 * conditions. The withheld states are designed states — see MunicipalCard.
 */
export const prerender = false;
import Base from "../../layouts/Base.astro";
import ScoreRing from "../../components/ScoreRing.astro";
import SignalRow from "../../components/SignalRow.astro";
import MunicipalCard from "../../components/MunicipalCard.astro";
import { authenticate } from "../../lib/auth/guard";
import { deltaLabel, BAND_TOKEN } from "../../lib/dashboardShared";
import { readAreaIndex } from "../../lib/account/readIndex";
import { formatDate, machineDate } from "../../lib/format";
import { getAddress, getAlertPrefs, listReminders } from "../../lib/account/db";
import { ALERT_CATALOGUE } from "../../lib/account/alertCatalogue";
import { readArrShard } from "../../lib/municipal/shards";
import { matchCollection } from "../../lib/municipal/match";
import { buildWateringView } from "../../lib/municipal/watering";
import {
  BUCKET_LABEL, SEASONAL_SUGGESTIONS, TASK_CATALOGUE, bucketFor, dueLabel, type DueBucket,
} from "../../lib/account/reminders";
import { WEEKLY_PREF_KEY, weeklyPrefState } from "../../lib/email/weeklyRecipients";

const auth = await authenticate(Astro.request);
if (!auth) return Astro.redirect("/home/sign-in/");
if (!auth.home) return Astro.redirect("/home/setup/");

const home = auth.home;
// Precomputed artifact, read from this Worker's own assets — see readIndex.ts
// for why the engine is not imported here.
const index = await readAreaIndex(home.areaId);
if (!index || !index.dashboard) return Astro.redirect(`/dashboard/${home.zip}/`);

const order = index.dashboard.signalOrder;
const signals = [...index.signals].sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
const unavailable = signals.filter((s) => !s.computable);
const weightCoverage = index.dashboard.weightCoverage;
const delta = index.dashboard.delta;
const series = index.dashboard.series ?? {};
const composite = index.compositeExplanation;
const band = index.composite;
const token = BAND_TOKEN[band.band];

const [reminders, prefs, address, weeklyPref] = await Promise.all([
  listReminders(home.id),
  getAlertPrefs(home.id),
  getAddress(home.id),
  // Round 9. Reports `available: false` until the migration is applied, and
  // the control below is omitted rather than shown broken.
  weeklyPrefState(auth.account.id),
]);

// Round 5b. One shard read through ASSETS — this ZIP's file only, never the
// whole table, and never a call out to the city on the serving path.
const shard = home.areaId === "austin" ? await readArrShard(home.zip) : null;
const collection = matchCollection(home.areaId, home.zip, address, shard);
const watering = buildWateringView(
  home.areaId,
  index.municipal?.waterStage ?? null,
  address,
  new Date(),
);

const now = new Date().toISOString();
const visible = reminders.filter((r) => !r.snoozedUntil || r.snoozedUntil <= now);
const snoozed = reminders.filter((r) => r.snoozedUntil && r.snoozedUntil > now);

const ORDER: DueBucket[] = ["overdue", "today", "this-week", "coming-up", "later"];
const grouped = ORDER.map((bucket) => ({
  bucket,
  label: BUCKET_LABEL[bucket],
  items: visible.filter((r) => bucketFor(r.nextDueAt, now) === bucket),
})).filter((g) => g.items.length > 0);

const openCount = visible.filter((r) => ["overdue", "today", "this-week"].includes(bucketFor(r.nextDueAt, now))).length;

// Condition alerts, from the same records the signals came from. Only the
// types this home has left switched on; unset means on.
const fired = index.alerts.filter((a) => prefs[a.key] !== false);

const seasonal = SEASONAL_SUGGESTIONS[new Date().getUTCMonth()] ?? [];
const unused = TASK_CATALOGUE.filter((t) => !reminders.some((r) => r.taskKey === t.key));
---

<Base title={`Your home — ${home.zip} | Texas Home Intelligence`} description="Your home dashboard." noindex>
  {/* ══ TIER 1 · STATUS ══════════════════════════════════════════════ */}
  <section class="dash-hero home-dash v2-status">
    <div class="wrap">
      <p class="eyebrow dash-eyebrow">Your home · {home.zip} · {home.countyName} County<span class="v2-eyebrow-sep"> · </span><span class="v2-eyebrow-tag">Home Stress Index</span></p>
      <h1 class="sr-only">Your home</h1>
      <div class="v2-status-grid">
        <div class="v2-score">
          <ScoreRing score={band.score} band={band.band} bandLabel={band.bandLabel} weightCoverage={weightCoverage} />
          <div class="v2-score-read">
            <div class="v2-chips">
              <p class={`dash-band status-${token}`} data-band-label>
                <span class="status-dot" aria-hidden="true"></span>{band.bandLabel}
              </p>
              <p class="v2-delta-chip" data-delta>
                {deltaLabel(delta.change)} since{" "}
                <time datetime={machineDate(delta.comparedTo)}>{formatDate(delta.comparedTo)}</time>
              </p>
            </div>
            <p class="dash-verdict">{composite.headline}</p>
            {weightCoverage < 1 && (
              <p class="dash-coverage" data-coverage>
                Measured from {Math.round(weightCoverage * 100)}% of the signals —{" "}
                {unavailable.map((s) => s.label).join(", ")} not published for this area.
              </p>
            )}
            <p class="dash-caveat">The Home Stress Index measures conditions in an area, not damage to a home. It is not a prediction, an inspection, or a probability of loss.</p>
            <p class="dash-links">
              <a href="/methodology/home-stress-index/">How this is calculated &nearr;</a>
              <a href={`/dashboard/${home.zip}/`}>Public view for {home.zip} &rarr;</a>
            </p>
          </div>
        </div>

        <div class="v2-identity">
          <p class="eyebrow">Signed in</p>
          <p class="dash-precision" data-account-email>{auth.account.email}</p>
          {address && <p class="dash-precision" data-address>{address}</p>}
          <p class="dash-precision" data-precision-note>Readings are for {home.countyName} County and the{" "}
            {home.areaId === "austin" ? "Austin" : "San Antonio"} metro — they describe the area,
            not this address.</p>
          <form method="post" action="/api/auth/sign-out/">
            <button class="btn secondary" type="submit">Sign out</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  {/* ══ TIER 2 · ACT — condition + this week | city services ═════════ */}
  <section class="block home-dash v2-act" id="this-week">
    <div class="wrap">
      <div class="v2-act-grid">
        <div class="v2-act-main">
          {/* Condition cards: present only while the condition holds. */}
          {fired.map((alert) => (
            <article class="card event-card" data-alert={alert.key}>
              <div class="v2-event-head">
                <p class="card-tag">{alert.label} · condition detected</p>
                <p class="data-meta v2-event-note">Goes away when the condition does</p>
              </div>
              <h2>{alert.headline}</h2>
              <p>{alert.detail}</p>
              <ul class="v2-event-list">
                {alert.checklist.map((item) => <li>{item}</li>)}
              </ul>
              <p class="data-meta">
                Source: {alert.source} · reading from{" "}
                <time datetime={machineDate(alert.observedAt)}>{formatDate(alert.observedAt)}</time>
              </p>
              <p class="dash-section-note">
                This card is here because the data showed the condition.
              </p>
            </article>
          ))}

          <section class="card v2-week" aria-labelledby="week-h">
            <header class="v2-week-head">
              <h2 id="week-h">Your home this week</h2>
              <p class="data-meta" data-open-count>{openCount} open · done items are remembered</p>
            </header>

            {grouped.length === 0 ? (
              <p class="v2-allclear" data-all-clear>
                Nothing due. Add something below and we'll keep track of when it's next needed.
              </p>
            ) : (
              grouped.map((group) => (
                <div class="queue-group" data-bucket={group.bucket}>
                  <h3>{group.label}</h3>
                  {group.items.map((r) => (
                    <div class="queue-item" data-reminder={r.id}>
                      <div>
                        <p class="queue-title">{r.label}</p>
                        <p class="queue-meta" data-due>
                          {dueLabel(r.nextDueAt, now)}
                          {r.lastDoneAt && (
                            <> · last done <time datetime={machineDate(r.lastDoneAt)}>{formatDate(r.lastDoneAt)}</time></>
                          )}
                          {" "}· every {r.cadenceDays} days
                        </p>
                      </div>
                      <div class="queue-actions">
                        <button class="btn" data-action="complete" data-id={r.id}>Done</button>
                        <button class="btn secondary" data-action="snooze" data-id={r.id}>Remind me</button>
                        <button class="btn secondary" data-action="skip" data-id={r.id}>Skip</button>
                      </div>
                    </div>
                  ))}
                </div>
              ))
            )}

            {snoozed.length > 0 && (
              <p class="dash-section-note" data-snoozed>
                {snoozed.length} snoozed. Snoozing hides an item for a while; it does not move the due
                date, so nothing gets quietly rescheduled.
              </p>
            )}

            <div class="add-reminder">
              <form method="post" action="/api/reminders/" data-add-reminder>
                <select name="task_key" class="notify-input" required aria-label="Add a reminder">
                  {unused.map((t) => (
                    <option value={t.key}>{t.label} — every {t.defaultCadenceDays} days</option>
                  ))}
                </select>
                <button class="btn" type="submit">Add</button>
              </form>
              {unused.length === 0 && <p class="dash-section-note">Everything in the catalogue is already on your list.</p>}
            </div>
          </section>
        </div>

        <aside class="v2-act-side">
          <MunicipalCard collection={collection} watering={watering} areaId={home.areaId} />
        </aside>
      </div>
    </div>
  </section>

  {/* ══ TIER 3 · READ — the signal instrument table ══════════════════ */}
  <section class="block alt home-dash v2-read">
    <div class="wrap">
      <header class="v2-read-head">
        <div>
          <h2>Five home signals</h2>
          <p class="data-meta">Indexes of conditions around {home.zip} · 0&ndash;100</p>
        </div>
        <p class="dash-section-note v2-read-note">
          Never a prediction of damage to your house{" "}
          <a href="/methodology/home-stress-index/">How scoring works &nearr;</a>
        </p>
      </header>

      <div class="sig-table" role="table" aria-label="Five home signals">
        <div class="sig-row sig-header" role="row" aria-hidden="true">
          <span class="sig-cell">Signal</span>
          <span class="sig-cell">Reading</span>
          <span class="sig-cell">Band</span>
          <span class="sig-cell">Trend</span>
          <span class="sig-cell">What it means · what to look at</span>
        </div>
        {signals.map((signal) => <SignalRow signal={signal} series={series[signal.id]} allowReminder />)}
      </div>
    </div>
  </section>

  {/* ══ TIER 4 · KEEP — memory, seasonal, alerts, account ════════════ */}
  <section class="block home-dash v2-keep">
    <div class="wrap">
      <div class="v2-keep-grid">
        <section class="card" aria-labelledby="remembers-h">
          <h2 id="remembers-h" class="v2-keep-h">What your home remembers</h2>
          <p class="eyebrow">Last done</p>
          {reminders.filter((r) => r.lastDoneAt).length === 0 ? (
            <p class="dash-section-note" data-no-history>Nothing marked done yet.</p>
          ) : (
            <ul class="v2-plain-list">
              {reminders.filter((r) => r.lastDoneAt).map((r) => (
                <li class="data-meta" data-history-item>
                  {r.label} · last done{" "}
                  <time datetime={machineDate(r.lastDoneAt!)}>{formatDate(r.lastDoneAt!)}</time> ·
                  next <time datetime={machineDate(r.nextDueAt)}>{formatDate(r.nextDueAt)}</time>
                </li>
              ))}
            </ul>
          )}
          <p class="dash-section-note">
            Marking an item done recalculates its next date from that day — the only history here
            is the one you record.
          </p>
        </section>

        <section class="card" aria-labelledby="seasonal-h">
          <h2 id="seasonal-h" class="v2-keep-h">Worth doing this month</h2>
          <ul class="v2-bullet-list">
            {seasonal.map((s) => <li>{s}</li>)}
          </ul>
          <p class="dash-section-note">
            General seasonal guidance for Central Texas — not a reading about your home.
          </p>
        </section>

        <section class="card" aria-labelledby="alerts-h">
          <h2 id="alerts-h" class="v2-keep-h">We'll tell you when something changes</h2>
          <div class="v2-prefs">
            {ALERT_CATALOGUE.map((a) => (
              <label class="alert-pref" data-alert-pref={a.key}>
                <input type="checkbox" data-pref={a.key} checked={prefs[a.key] !== false} />
                <span>
                  <strong>{a.label}</strong>
                  <span class="dash-section-note v2-pref-note">{a.description}</span>
                </span>
              </label>
            ))}
          </div>
          <p class="dash-section-note">
            Alerts describe conditions in your area, never your individual house, and they are sent
            only while a condition holds.
          </p>

          {weeklyPref.available && (
            <div class="v2-weekly-pref" data-weekly-pref>
              <label class="alert-pref">
                <input type="checkbox" data-weekly={WEEKLY_PREF_KEY} checked={weeklyPref.enabled} />
                <span>
                  <strong>Weekly summary email</strong>
                  <span class="dash-section-note v2-pref-note">
                    One email a week with this reading, what moved, one thing worth looking at, and
                    anything due. Off unless you switch it on; every message can turn it back off.
                  </span>
                </span>
              </label>
            </div>
          )}
        </section>
      </div>

      <div class="v2-account" data-account-strip>
        <p class="eyebrow">Account &amp; data</p>
        <p class="dash-section-note">
          Signed in as {auth.account.email}. Readings come from public sources on a schedule; your
          reminders and last-done dates are the only home-specific information here, and they stay
          private to this account.
        </p>
        <p class="v2-account-links">
          <a href="/methodology/home-stress-index/">How this is calculated &nearr;</a>
          <a href="/privacy/#your-account">Delete my account and data &rarr;</a>
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  const post = async (url: string, fields: Record<string, string>) => {
    const body = new FormData();
    for (const [k, v] of Object.entries(fields)) body.append(k, v);
    const res = await fetch(url, { method: "POST", body });
    return { ok: res.ok, data: (await res.json().catch(() => ({}))) as Record<string, unknown> };
  };

  document.querySelectorAll("[data-action]").forEach((node) => {
    node.addEventListener("click", async () => {
      const btn = node as HTMLButtonElement;
      const action = btn.dataset.action!;
      btn.disabled = true;
      const { ok } = await post("/api/reminders/action/", {
        reminder_id: btn.dataset.id!, action, days: "3",
      });
      if (ok) {
        if (action === "complete") window.__thiTrack?.("reminder_completed", {});
        window.location.reload();
      } else {
        btn.disabled = false;
      }
    });
  });

  // "Track this" on a signal card creates the matching reminder, reusing the
  // same endpoint as the queue's add form.
  document.querySelectorAll("[data-action-reminder]").forEach((node) => {
    if (!(node instanceof HTMLFormElement)) return;
    node.addEventListener("submit", async (event) => {
      event.preventDefault();
      const res = await fetch("/api/reminders/", { method: "POST", body: new FormData(node) });
      if (res.ok) {
        window.__thiTrack?.("reminder_created", { from: "signal_action" });
        window.location.assign("/home/#this-week");
        window.location.reload();
      }
    });
  });

  document.querySelectorAll("[data-add-reminder]").forEach((node) => {
    if (!(node instanceof HTMLFormElement)) return;
    node.addEventListener("submit", async (event) => {
      event.preventDefault();
      const res = await fetch("/api/reminders/", { method: "POST", body: new FormData(node) });
      if (res.ok) {
        window.__thiTrack?.("reminder_created", {});
        window.location.reload();
      }
    });
  });

  document.querySelectorAll("[data-weekly]").forEach((node) => {
    if (!(node instanceof HTMLInputElement)) return;
    node.addEventListener("change", async () => {
      await post("/api/account/email-prefs/", {
        pref_key: node.dataset.weekly!, enabled: node.checked ? "yes" : "no",
      });
      window.__thiTrack?.("weekly_email_pref_set", { enabled: String(node.checked) });
    });
  });

  document.querySelectorAll("[data-pref]").forEach((node) => {
    node.addEventListener("change", async () => {
      const input = node as HTMLInputElement;
      await post("/api/account/alert-prefs/", {
        alert_key: input.dataset.pref!, enabled: input.checked ? "yes" : "no",
      });
      window.__thiTrack?.("alert_pref_set", { alert: input.dataset.pref });
    });
  });
</script>
