---
/**
 * /home/sign-in/ — request a magic link.
 *
 * noindex: a sign-in form is not a citation asset, and indexing it would put a
 * consent checkbox in search results with no context around it.
 */
export const prerender = false;
import Base from "../../layouts/Base.astro";
import { authenticate } from "../../lib/auth/guard";

const auth = await authenticate(Astro.request);
if (auth) return Astro.redirect(auth.home ? "/home/" : "/home/setup/");

const error = Astro.url.searchParams.get("error");
const title = "Sign in | Texas Home Intelligence";
---

<Base title={title} description="Sign in to your Texas Home Intelligence home dashboard." noindex>
  <section class="hero">
    <div class="wrap" style="max-width:520px;">
      <span class="eyebrow">YOUR HOME</span>
      <h1>Sign in</h1>
      <p class="lede">
        You're one email away from your home's dashboard — weekly conditions for your ZIP, alerts
        for your county, and reminders that reschedule themselves.
      </p>
      <p>
        No password. We email you a link that signs you in and expires in fifteen minutes.
      </p>

      {error === "link" && (
        <p class="dash-notcovered" data-link-error>
          That link didn't work — it may have expired or already been used. Request a new one below.
        </p>
      )}

      <form class="notify-form" method="post" action="/api/auth/request-link/" data-signin-form>
        <input type="hidden" name="consent_source" value="home_sign_in" />
        <label class="notify-label" for="email">Email address</label>
        <input id="email" class="notify-input" type="email" name="email" required autocomplete="email" placeholder="you@example.com" />

        <label class="notify-consent">
          <input type="checkbox" name="consent" value="yes" required data-consent />
          <span>
            Create my account and email me sign-in links. Unsubscribe anytime.
          </span>
        </label>

        {/*
          A SEPARATE box, unticked, and not required. The consent above covers
          sign-in links and the alerts they pick; a weekly digest is neither, so
          it gets asked for on its own rather than folded into a checkbox people
          tick to create an account at all. Leaving it unticked here is a
          complete answer — nothing is enrolled by default, and nobody who
          signed up before this box existed is enrolled retroactively.
        */}
        <label class="notify-consent notify-consent--optional">
          <input type="checkbox" name="weekly" value="yes" data-weekly-optin />
          <span>
            <strong>Also send me the weekly summary email.</strong> One message a week: your home's
            reading, what changed, one thing worth checking, and anything you're tracking. Optional
            &mdash; and every message can turn it off.
          </span>
        </label>

        <button class="btn" type="submit">Email me my sign-in link</button>
        <p class="notify-fineprint">
          Nothing is stored until you tick the box and open the link.
          <a href="/privacy/">How we handle your data &rarr;</a>
        </p>
        <p class="notify-status" data-status role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll("[data-signin-form]").forEach((node) => {
    if (!(node instanceof HTMLFormElement)) return;
    const form = node;
    const status = form.querySelector("[data-status]");
    form.addEventListener("submit", async (event) => {
      const consent = form.querySelector("[data-consent]");
      if (!(consent instanceof HTMLInputElement) || !consent.checked) return;
      event.preventDefault();
      if (status) status.textContent = "Sending…";
      const res = await fetch("/api/auth/request-link/", { method: "POST", body: new FormData(form) });
      const data = (await res.json().catch(() => ({}))) as { message?: string; error?: string; transport?: string };
      window.__thiTrack?.("link_requested", {});
      if (status) {
        status.textContent = res.ok
          ? data.transport === "stub"
            ? "Email delivery isn't switched on yet — the link was written to the server log."
            : (data.message ?? "Check your email.")
          : (data.error ?? "That didn't go through.");
      }
    });
  });
</script>
