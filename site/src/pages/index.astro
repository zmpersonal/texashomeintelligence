---
import Base from "../layouts/Base.astro";
---

<Base
  title="Texas Home Intelligence | Free QuoteReady Project Brief"
  description="Build a free QuoteReady Project Brief for your Texas home repair project, then use it with any contractor."
>
  <section class="border-b border-line bg-gradient-to-b from-[#f5f9fc] to-white px-5 py-16">
    <div class="mx-auto max-w-[1120px]">
      <span
        class="mb-4 inline-block rounded-full bg-[#fdeee0] px-3 py-1 text-xs font-extrabold tracking-wide text-accent-dark"
      >
        PHASE 0 — SCAFFOLD ONLY
      </span>
      <h1 class="max-w-2xl text-3xl font-extrabold text-ink sm:text-4xl">
        Astro + Tailwind + Cloudflare scaffold is wired up.
      </h1>
      <p class="mt-4 max-w-xl text-ink-soft">
        This page exists to prove the base layout, design tokens, and build
        pipeline work end to end. Real homepage content — reusing the
        section order already approved on the live site — lands in Phase 2.
      </p>
      <div class="mt-8 rounded-[10px] border border-line bg-white p-5 shadow-[0_1px_2px_rgba(16,24,38,0.06),0_8px_24px_rgba(16,24,38,0.06)]">
        <span class="rounded-full bg-[#e5f3ea] px-3 py-1 text-xs font-extrabold text-good">
          Sample output
        </span>
        <h2 class="mt-3 text-base font-bold text-brand-dark">Design token check</h2>
        <ul class="mt-2 space-y-1 text-sm text-ink-soft">
          <li>Brand navy button below, accent amber background above</li>
          <li>Tailwind v4 CSS-first theme (<code>@theme</code>) driving utilities</li>
        </ul>
        <a
          href="#"
          class="mt-4 inline-block rounded-lg bg-accent px-6 py-3 font-extrabold text-white"
        >
          Build My QuoteReady Brief
        </a>
      </div>
    </div>
  </section>
</Base>
