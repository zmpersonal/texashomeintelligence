---
/**
 * Homepage.
 *
 * Round 2 changes, all structural:
 *  - The four-card grid that sat directly below the hero is gone (ROADMAP.md
 *    drops it for this build), so the live-data section is now the first thing
 *    under the hero — the site leads with data rather than with navigation.
 *  - Every SAMPLE card is gone. Four of the ten cards here were illustrative
 *    placeholders (cooling-degree stress, water/irrigation, HVAC, fire), which
 *    REVIEW.md forbids on an indexed page. Rather than dress them up, the
 *    sections now show only what is actually measured, and each live card
 *    links to the data page that backs it.
 *  - The FAQ renders from `src/data/faq.yaml` instead of a hardcoded DRAFT
 *    duplicate that had drifted from it.
 *  - "Texas Homeowner Guides" is gone: eight "Coming soon" labels that were
 *    not links to anything.
 *
 * Figures come from the same generated datasets the data pages read, via the
 * published-page registry, so the homepage cannot contradict them.
 */
import Base from "../layouts/Base.astro";
import DataStatus from "../components/DataStatus.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import DroughtMapHero from "../components/DroughtMapHero.astro";
import LiveConditionsPanel from "../components/LiveConditionsPanel.astro";
import { getCollection } from "astro:content";
import { publishedDataPages } from "../lib/dataPages";
import { findDataset, freshnessOf } from "../lib/datasets";

const faqEntries = await getCollection("faq");
const faqItems = faqEntries.map((e) => ({ q: e.data.q, a: e.data.a }));

/**
 * The live-data strip. Curated rather than "every published page", so the
 * homepage stays a summary — but each entry resolves through the registry, so
 * a card cannot outlive the page it points at.
 */
const FEATURED = [
  { location: "austin", topic: "roofing", label: "Austin hail & storm events" },
  { location: "san-antonio", topic: "roof-permits", label: "San Antonio re-roof permits" },
  { location: "austin", topic: "drought", label: "Austin drought conditions" },
  { location: "texas", topic: "electricity-prices", label: "Texas electricity prices" },
];

const published = publishedDataPages();
const featured = FEATURED.map((f) => {
  const spec = published.find((s) => s.location === f.location && s.topic === f.topic);
  if (!spec) return undefined;
  const dataset = findDataset(spec.datasetId, spec.location)!;
  const observations = dataset.observations.filter((o) => !o.seed);
  const stat = spec.stats({ dataset, observations })[0];
  return { spec, dataset, freshness: freshnessOf(dataset), label: f.label, stat };
}).filter((f) => f !== undefined);

const servicePicks = [
  { name: "Roofing", blurb: "Leak? Storm damage? Aging roof? Comparing replacement options?", service: "roofing" },
  { name: "HVAC", blurb: "Not cooling? Weak airflow? Uneven temperatures? Thinking about replacement?", service: "hvac" },
  { name: "Plumbing", blurb: "Leak, drain problem, water heater, low pressure, or sewer issue?", service: "plumbing" },
  { name: "Fire Damage", blurb: "Recent fire or smoke damage? Not sure where to start?", service: "fire-damage-restoration" },
  { name: "Mold", blurb: "Visible mold, musty smell, or a past leak you're worried about?", service: "mold-remediation" },
  { name: "Electrical", blurb: "Tripping breakers, flickering lights, or a panel that's acting up?", service: "electrical" },
  { name: "Tree Trimming", blurb: "Dead limbs, storm damage, or a tree too close to your house?", service: "tree-trimming" },
];

const primarySources = [
  { title: "Weather & Climate", items: ["NWS", "NOAA"] },
  { title: "Texas Water & Drought", items: ["U.S. Drought Monitor"] },
  { title: "Hazards", items: ["FEMA", "Texas A&M Forest Service"] },
  { title: "Housing & Permits", items: ["Census", "City / municipal permit systems"] },
  { title: "Insurance", items: ["Texas Department of Insurance"] },
  { title: "Costs & Energy", items: ["BLS", "EIA", "ERCOT"] },
  { title: "Environment", items: ["EPA AirNow", "USDA"] },
];

const dateModified = featured
  .map((f) => f.freshness.asOf)
  .filter((v): v is string => Boolean(v))
  .sort()
  .at(-1);

const title = "Texas Home Intelligence — Data, Tools & Local Home Intelligence for Texas Homeowners";
const description =
  "Texas-specific data, tools, and local home-service intelligence to help homeowners understand risks, maintenance, repair costs, and when to take action.";
---

<Base title={title} description={description} article={{ dateModified }}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">Free for Texas homeowners · Austin &amp; San Antonio</span>
        <h1>Texas is hard on houses. Stay a week ahead of it.</h1>
        <p class="lede">
          Hail, drought, and 100&deg; weeks are working on your home right now — mostly where you
          can't see it. Get a free weekly read on what conditions in your ZIP are doing to roofs,
          foundations, and AC systems, built from the same public records insurers and inspectors
          use.
        </p>
        <div class="hero-actions">
          <a class="btn" href="/dashboard/">Check my ZIP — free, no account</a>
          <a class="btn secondary" href="/methodology/">See where the data comes from</a>
        </div>
        <p class="microcopy">
          Takes about two minutes. Updated every week from NOAA, the U.S. Drought Monitor, and
          city permit records.
        </p>
      </div>
      <LiveConditionsPanel
        location="austin"
        locationLabel="Austin"
        topics={["roofing", "drought", "roof-permits"]}
        trendTopic="drought"
        trendValue={(v) => {
          const m = String(v.droughtIndex ?? "").match(/^D(\d)/);
          return m ? Number(m[1]) + 1 : 0;
        }}
        trendLabel="Travis County drought severity, weekly"
      />
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2>What Texas threw at homes this week</h2>
      <p style="max-width:44em;">
        Every number below is computed from public records, with its source and last-confirmed
        date attached. Follow any card for the full dataset and its limitations.
      </p>
      <div class="grid-4">
        {featured.map(({ spec, dataset, freshness, label, stat }) => (
          <a class="card data-card card-link" href={`/data/${spec.location}/${spec.topic}/`}>
            <p class="metric-label">{label}</p>
            <p class="metric-value">{stat.value}</p>
            <p class="metric-note">{stat.label}</p>
            <DataStatus
              status={dataset.status}
              asOf={freshness.asOf}
              dataThrough={freshness.dataThrough}
              source={dataset.source.name}
            />
          </a>
        ))}
      </div>
      <p style="margin-top:20px;"><a href="/data/">See the full data catalog &rarr;</a></p>
    </div>
  </section>

  {/* Round 8: the stakes. Deliberately non-numeric — the copy doc invited real
      local cost figures "if defensible", and nothing in our permit data supports
      a typical replacement cost (we ingest permit counts and declared
      valuations for roofing work, which is not the same as what a homeowner
      pays). Qualitative framing stands until a figure is genuinely derivable. */}
  <section class="block">
    <div class="wrap" style="max-width:760px;">
      <h2>The expensive stuff starts quietly</h2>
      <p>
        Most five-figure home repairs in Central Texas don't start with a disaster. They start
        with an inch of hail nobody documented, a drought year that moved the soil under the
        slab, or a summer that ran the AC 11 days straight over 100&deg;.
      </p>
      <p>
        A roof replacement, a foundation repair, or a new HVAC system each typically runs well
        into five figures. Knowing what your area's been through — this week, this season — is
        how you catch small problems while they're still small, and how you know whether the
        contractor at your door is telling the truth.
      </p>
      <p style="margin-top:20px;">
        <a href="/dashboard/">See what your ZIP has been through &rarr;</a>
      </p>
    </div>
  </section>

  {/* FLAG (copy round): card CTAs used to read "Start a __ Brief" and pointed
      at the QuoteReady intake. They now point at the Austin service pages —
      the real authority content — which also gives those 14 indexed pages a
      route in from the homepage. Blurb copy is unchanged. */}
  <section class="block alt">
    <div class="wrap">
      <h2>Something on your mind?</h2>
      <p style="max-width:44em;">
        Start with the problem, not the paperwork. Pick what's going on and see what we know
        about it locally.
      </p>
      <div class="grid-4">
        {servicePicks.map((s) => (
          <div class="pick-card">
            <h3>{s.name}</h3>
            <p>{s.blurb}</p>
            <a class="pick-link" href={`/austin/${s.service}/`}>{s.name} in Austin &rarr;</a>
          </div>
        ))}
      </div>
      <p style="margin-top:20px;">
        Nothing going wrong today? Good — that's the best time to look.{" "}
        <a href="/dashboard/">Check this week's conditions in your ZIP &rarr;</a>
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2>How Texas Home Intelligence works</h2>
      <p style="max-width:44em;">
        No black box. Every number on this site falls into one of four buckets, and each one is
        labeled so you always know what you're looking at.
      </p>
      <div class="grid-4">
        <div class="card method-card">
          <h3>Public / observed data</h3>
          <p>Information directly reported by authoritative sources &mdash; weather services, permit systems, and state agencies.</p>
        </div>
        <div class="card method-card">
          <h3>Historical context</h3>
          <p>How a current value compares with previous conditions or seasonal norms, not just a single snapshot.</p>
        </div>
        <div class="card method-card">
          <h3>THI analysis</h3>
          <p>Our own plain-language interpretation of what the data may mean for a homeowner's project or timing.</p>
        </div>
        <div class="card method-card">
          <h3>Estimates &amp; homeowner information</h3>
          <p>Modeled values and anything a homeowner tells us directly are always clearly labeled as such.</p>
        </div>
      </div>
      <p style="margin-top:20px;"><a href="/methodology/">Read our methodology &rarr;</a></p>
    </div>
  </section>

  <section class="block">
    <div class="wrap" style="max-width:760px;">
      <h2>The map that moves your foundation</h2>
      <p>
        The U.S. Drought Monitor publishes a new Texas map every Thursday. In Central Texas clay
        soil, that map is a slow-motion picture of the ground expanding and shrinking under your
        slab — which is why it's one of the five signals in your ZIP's score.
      </p>
      <div class="drought-map--inline">
        <DroughtMapHero />
      </div>
      <p style="margin-top:20px;">
        <a href="/data/austin/drought/">See your county's weekly drought reading &rarr;</a>
      </p>
    </div>
  </section>

  <section class="block alt">
    <div class="wrap">
      <h2>Built from primary sources</h2>
      <div class="grid-4">
        {primarySources.map((s) => (
          <div class="source-col">
            <h3>{s.title}</h3>
            <ul>{s.items.map((item) => <li>{item}</li>)}</ul>
          </div>
        ))}
      </div>
      <p style="margin-top:20px;"><a href="/methodology/">See every source and its current state &rarr;</a></p>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <h2>Already dealing with a problem? Walk in with the facts.</h2>
      <p style="max-width:40em;margin:0 auto 20px;">
        Turn what you know — and what the data shows for your area — into a clear project brief
        before you talk to a single contractor. Free, and yours to use with anyone.
      </p>
      <a class="btn" href="/start/">Build a Project Brief</a>
      <p class="microcopy cta-band-note">
        Free &bull; Use it with any contractor &bull; Contractor introductions are optional
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap" style="max-width:760px;">
      <FaqAccordion heading="Frequently asked questions" items={faqItems} />
    </div>
  </section>
</Base>
