---
import { getCollection } from "astro:content";
import LocationHub from "../../layouts/LocationHub.astro";
import CityHub from "../../layouts/CityHub.astro";
import { isLocation } from "../../data/locations";

export async function getStaticPaths() {
  const locations = await getCollection("locations");
  return locations.map((loc) => ({
    params: { location: loc.id },
  }));
}

const { location } = Astro.params;
---

{isLocation(location!) ? <CityHub locationSlug={location} /> : <LocationHub locationSlug={location} />}
